#!/usr/bin/env python3
"""Open the small demo in Helix with temporary configuration and a scratch copy."""

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


def main():
    root = Path(__file__).resolve().parent
    with tempfile.TemporaryDirectory(prefix="rfr-markdown-") as directory:
        helix = Path(directory) / "helix"
        helix.mkdir()
        config = helix / "config.toml"
        config.write_text('[keys.normal]\n"`" = ":lsp-workspace-command redFactor.setDepth"\n')
        (helix / "languages.toml").write_text(
            '[[language]]\nname = "markdown"\nlanguage-servers = ["red-factor-retract"]\n'
            'auto-format = false\n\n[language-server.red-factor-retract]\ncommand = '
            + json.dumps(str(root / "red-factor-retract")) + '\n'
        )
        sample = Path(directory) / "test-statements.md"
        shutil.copyfile(root / "test-statements.md", sample)
        env = dict(os.environ, XDG_CONFIG_HOME=directory)
        return subprocess.call([
            "hx", "--config", str(config), "--log", str(helix / "helix.log"), str(sample),
        ], env=env, cwd=root)


if __name__ == "__main__":
    sys.exit(main())
