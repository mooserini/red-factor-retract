#!/usr/bin/env python3
"""red-factor-retract — semantic relationships LSP for YAML and Markdown.
Helix talks stdio JSON-RPC. Hosted inference or a local llama-server returns
diagnostics, mapped to YAML keys or evidence-backed Markdown passages.

No deps. Python 3.10+.
Env:
  RFR_BACKEND=auto  (auto|openrouter|local; auto = hosted first, local fallback)
  RFR_OPENROUTER_MODEL=openrouter/free
  RFR_LLM_URL=http://127.0.0.1:8222/v1/chat/completions  (local fallback)
  RFR_MODEL=gemma-4
  RFR_DEPTH=1  (0 minimal, 1 normal, 2 deepleaf)
  RFR_TIMEOUT=20
  RFR_CONSTRAINTS=/path/to/providers.json
"""
import sys, os, json, re, hashlib, time, urllib.request, urllib.error, urllib.parse
from dataclasses import replace

from rfr_markdown import build_request, map_contradictions, read_paragraphs

LLM_URL = os.environ.get("RFR_LLM_URL", "http://127.0.0.1:8222/v1/chat/completions")
MODEL = os.environ.get("RFR_MODEL", "gemma-4")
TIMEOUT = int(os.environ.get("RFR_TIMEOUT", "20"))
DEPTH = int(os.environ.get("RFR_DEPTH", "1"))
# Backend: auto = OpenRouter free router first, local llama-server fallback.
# Set RFR_BACKEND=local to force local-only (fully offline), or =openrouter for hosted-only.
BACKEND = os.environ.get("RFR_BACKEND", "auto")
OR_URL = os.environ.get("RFR_OPENROUTER_URL", "https://openrouter.ai/api/v1/chat/completions")
OR_MODEL = os.environ.get("RFR_OPENROUTER_MODEL", "openrouter/free")
OR_TIMEOUT = int(os.environ.get("RFR_OPENROUTER_TIMEOUT", "60"))

def here(p): return os.path.join(os.path.dirname(os.path.abspath(__file__)), p)
CONSTRAINTS_PATH = os.environ.get("RFR_CONSTRAINTS", here("providers.json"))

docs = {}   # uri -> {"text": str, "version": int, "languageId": str}
depth = DEPTH
_cache = {}

SYSTEM_PROMPT = (
"You are a semantic dependency analyzer for YAML config files. "
"Analyze the YAML and the proposed change. Identify conflicting downstream fields, "
"invalid provider parameters, or logical breaks. "
"Return ONLY JSON matching the schema. No prose. "
"Focus on relational impacts, not syntax. Use dot paths like tts.provider. "
"impact 0-1: 1.0 = will break resolve, 0.0 = isolated."
)

SCHEMA = {
  "type": "object",
  "properties": {"diagnostics": {"type": "array", "items": {
    "type": "object",
    "properties": {
      "path": {"type": "string"},
      "impact": {"type": "number"},
      "severity": {"type": "string", "enum": ["error","warning","information","hint"]},
      "message": {"type": "string"},
      "related_field": {"type": "string"}
    },
    "required": ["path","impact","severity","message"],
    "additionalProperties": False
  }}},
  "required": ["diagnostics"],
  "additionalProperties": False
}

SEV_INT = {"error":1, "warning":2, "information":3, "hint":4}

def log(*a):
    print("RFR:", *a, file=sys.stderr, flush=True)

def load_constraints():
    try:
        with open(CONSTRAINTS_PATH) as f: return json.load(f)
    except Exception as e:
        log("no constraints:", e); return {}

def find_path_range(lines, dotpath):
    """Naive dot-path -> range. Last segment `key:` wins. Good enough for v1, no yaml dep."""
    key = dotpath.split(".")[-1].strip()
    pat = re.compile(rf"^(\s*)(?:-\s*)?{re.escape(key)}\s*:")
    for i, ln in enumerate(lines):
        m = pat.match(ln)
        if m:
            indent = len(m.group(1))
            # value starts after colon; highlight the value token if present
            colon = ln.find(":", indent)
            start = colon + 1
            while start < len(ln) and ln[start] in " \t": start += 1
            end = len(ln.rstrip("\n"))
            if start >= end:  # key-only line, highlight key
                start = indent; end = indent + len(key)
            return {"start":{"line":i,"character":start},"end":{"line":i,"character":max(end,start+1)}}
    return None

def severity_for(impact, given):
    if given in SEV_INT: return given
    if impact >= 0.8: return "error"
    if impact >= 0.5: return "warning"
    if impact >= 0.2: return "information"
    return "hint"

def get_openrouter_key():
    """Key never lives in files: env first, macOS keychain second."""
    k = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if k: return k
    try:
        import subprocess
        r = subprocess.run(["security","find-generic-password","-s","OPENROUTER_API_KEY","-w"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip(): return r.stdout.strip()
    except Exception as e:
        log("keychain lookup failed:", e)
    return ""

SECRET_PAT = re.compile(r"(?im)^(\s*(?:api[_-]?key|api[_-]?secret|token|auth[_-]?token|password|secret|private[_-]?key|access[_-]?key)\s*:\s*)(.+?)\s*$")

def redact_secrets(yaml_text):
    """Mask matching single-line keys; this is not a comprehensive secret filter."""
    return SECRET_PAT.sub(lambda m: m.group(1) + "[REDACTED]", yaml_text)

def post_chat(url, body, headers, timeout):
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        resp = json.loads(r.read().decode())
    content = resp["choices"][0]["message"]["content"]
    content = re.sub(r"^```(?:json)?\s*|\s*```$", "", content.strip())
    parsed = json.loads(content)
    if isinstance(parsed, dict) and "diagnostics" in parsed:
        return parsed, resp
    raise ValueError("unexpected shape")

def call_openrouter(user_payload, *, system_prompt=SYSTEM_PROMPT, schema=SCHEMA):
    key = get_openrouter_key()
    if not key: raise RuntimeError("no OPENROUTER_API_KEY (env or keychain)")
    base = {
      "model": OR_MODEL, "temperature": 0, "stream": False,
      "messages": [
        {"role":"system","content": system_prompt},
        {"role":"user","content": user_payload}
      ],
    }
    headers = {"Content-Type":"application/json", "Authorization":f"Bearer {key}",
               "HTTP-Referer":"https://localhost/red-factor-retract", "X-Title":"Red Factor Retract"}
    # primary: strict json_schema (free router filters for capable models)
    try:
        b = dict(base); b["response_format"] = {"type":"json_schema","json_schema":{"name":"SemanticImpact","strict":True,"schema":schema}}
        parsed, resp = post_chat(OR_URL, b, headers, OR_TIMEOUT)
        log("openrouter model:", resp.get("model"))
        return parsed
    except Exception as e:
        log("openrouter json_schema failed, retrying json_object:", e)
    b = dict(base); b["response_format"] = {"type":"json_object"}
    parsed, resp = post_chat(OR_URL, b, headers, OR_TIMEOUT)
    log("openrouter model:", resp.get("model"))
    return parsed

def call_local(body):
    # primary: json_schema
    for mode in ("json_schema", "json_object"):
        try:
            b = dict(body)
            if mode == "json_object":
                b["response_format"] = {"type":"json_object"}
            parsed, resp = post_chat(LLM_URL, b, {"Content-Type":"application/json"}, TIMEOUT)
            log("local model:", resp.get("model"))
            return parsed
        except Exception as e:
            log(f"llm {mode} failed:", e)
    raise RuntimeError("local backend failed or returned an invalid response")

def request_analysis(user_payload, *, system_prompt, schema):
    if BACKEND in ("auto", "openrouter"):
        try:
            return call_openrouter(user_payload, system_prompt=system_prompt, schema=schema)
        except Exception as e:
            log("openrouter failed:", e)
            if BACKEND == "openrouter":
                raise
            log("falling back to local")
    body = {
      "model": MODEL, "temperature": 0, "stream": False,
      "messages": [
        {"role":"system","content": system_prompt},
        {"role":"user","content": user_payload}
      ],
      "response_format": {"type":"json_schema","json_schema":{"name":"SemanticImpact","schema":schema}}
    }
    return call_local(body)

def call_llm(yaml_text, changed_info, depth_level):
    constraints = load_constraints() if depth_level >= 2 else {}
    safe_yaml = redact_secrets(yaml_text)
    user_payload = (
f"Depth: {depth_level}\nChanged: {changed_info}\n"
"YAML:\n```yaml\n" + safe_yaml[:6000] + "\n```\n"
+ (f"Known constraints:\n{json.dumps(constraints)[:2000]}" if constraints else "Known constraints: (none, use general reasoning)")
    )
    return request_analysis(user_payload, system_prompt=SYSTEM_PROMPT, schema=SCHEMA)

def is_markdown(uri, doc):
    language = doc.get("languageId", "").lower()
    if language:
        return language == "markdown"
    return urllib.parse.unquote(urllib.parse.urlparse(uri).path).lower().endswith((".md", ".markdown"))

def markdown_status(uri, message):
    first_line = docs.get(uri, {}).get("text", "").splitlines()
    end = len(first_line[0][:1].encode("utf-16-le")) // 2 if first_line else 0
    return {
        "range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": end}},
        "severity": 3, "source": "red-factor", "code": "markdown-analysis-status",
        "message": message,
    }

def infer_markdown_and_publish(uri):
    doc = docs.get(uri)
    if doc is None:
        return
    text = doc.get("text", "")

    def publish(diagnostics):
        send_notification("textDocument/publishDiagnostics", {
            "uri": uri, "version": doc.get("version", 0), "diagnostics": diagnostics,
        })

    if len(text) > 6000:
        publish([markdown_status(uri, "Markdown not analyzed: this first version accepts complete documents up to 6,000 characters.")])
        return
    paragraphs = read_paragraphs(text)
    if not paragraphs:
        publish([])
        return
    key = "markdown:" + hashlib.sha256(json.dumps([uri, text, depth]).encode()).hexdigest()
    if key in _cache:
        publish(_cache[key])
        return
    started = time.monotonic()
    # Mask each passage without re-parsing: redaction must not reassign source IDs.
    safe_paragraphs = [replace(p, text=redact_secrets(p.text), heading=redact_secrets(p.heading)) for p in paragraphs]
    system, payload, schema = build_request(safe_paragraphs, depth)
    try:
        result = request_analysis(payload, system_prompt=system, schema=schema)
    except Exception as e:
        log("markdown backend failed:", e)
        publish([markdown_status(uri, "Markdown analysis failed; no conclusion was reached. Save or use the depth command to retry.")])
        return
    try:
        out = map_contradictions(text, paragraphs, result, uri)
    except ValueError as e:
        log("markdown invalid response:", e)
        publish([markdown_status(uri, "Markdown analysis returned invalid evidence; no conclusion was reached. Save or use the depth command to retry.")])
        return
    log(f"markdown analysis: {len(paragraphs)} passages, {len(out)} conflicts, {time.monotonic() - started:.2f}s")
    _cache[key] = out
    if len(_cache) > 64:
        _cache.pop(next(iter(_cache)))
    publish(out)

def infer_and_publish(uri, changed_info="full file"):
    global _cache
    doc = docs.get(uri, {})
    if is_markdown(uri, doc):
        infer_markdown_and_publish(uri)
        return
    text = doc.get("text", "")
    if not text.strip():
        send_notification("textDocument/publishDiagnostics", {"uri":uri,"diagnostics":[]}); return
    h = hashlib.sha256((text+changed_info+str(depth)).encode()).hexdigest()
    if h in _cache:
        send_notification("textDocument/publishDiagnostics", {"uri":uri,"diagnostics":_cache[h]}); return
    lines = text.splitlines()
    lines = [l if len(l) <= 2000 else l[:2000] for l in lines]
    try:
        result = call_llm(text, changed_info, depth)
    except Exception as e:
        log("infer error:", e); result = {"diagnostics":[]}
    out = []
    for d in result.get("diagnostics", [])[:20]:
        try:
            path = str(d.get("path","")).strip()
            if not path: continue
            impact = float(d.get("impact", 0.5))
            if impact < 0.15: continue  # suppress noise
            sev = severity_for(impact, d.get("severity",""))
            rng = find_path_range(lines, path)
            if not rng: log("path not found, dropping:", path); continue
            out.append({"range": rng, "severity": SEV_INT[sev],
                        "source": "red-factor",
                        "message": f"[impact {impact:.2f}] {d.get('message','')} (via {d.get('related_field', changed_info)})"})
        except Exception as e:
            log("diag map error:", e); continue
    _cache[h] = out
    # cap cache
    if len(_cache) > 64: _cache.pop(next(iter(_cache)))
    send_notification("textDocument/publishDiagnostics", {"uri":uri,"diagnostics":out})

# ---- JSON-RPC stdio ----
_out = sys.stdout.buffer
_in = sys.stdin.buffer

def send(msg):
    b = json.dumps(msg, separators=(",",":")).encode()
    _out.write(f"Content-Length: {len(b)}\r\n\r\n".encode()); _out.write(b); _out.flush()

def send_response(id_, result):
    send({"jsonrpc":"2.0","id":id_,"result":result})

def send_error(id_, msg):
    send({"jsonrpc":"2.0","id":id_,"error":{"code":-32603,"message":msg}})

def send_notification(method, params):
    send({"jsonrpc":"2.0","method":method,"params":params})

def read_msg():
    headers = {}
    while True:
        line = _in.readline().decode("utf-8", "replace").strip()
        if line == "": break
        if ":" in line:
            k,v = line.split(":",1); headers[k.strip().lower()] = v.strip()
    n = int(headers.get("content-length", "0"))
    if not n: return None
    return json.loads(_in.read(n).decode("utf-8", "replace"))

def handle(msg):
    global depth
    method = msg.get("method",""); id_ = msg.get("id"); p = msg.get("params",{}) or {}
    if method == "initialize":
        send_response(id_, {"capabilities":{"textDocumentSync":{"openClose":True,"change":1,"save":{"includeText":True}},
            "executeCommandProvider":{"commands":["redFactor.setDepth"]}}})
    elif method in ("initialized","$/setTrace","workspace/didChangeConfiguration"):
        pass
    elif method == "shutdown":
        send_response(id_, None); return "shutdown"
    elif method == "exit":
        sys.exit(0)
    elif method == "textDocument/didOpen":
        td = p.get("textDocument",{}); docs[td.get("uri","")] = {"text":td.get("text",""),"version":td.get("version",0),"languageId":td.get("languageId","")}
        infer_and_publish(td.get("uri",""), "open")
    elif method == "textDocument/didChange":
        td = p.get("textDocument",{}); uri = td.get("uri","")
        changes = p.get("contentChanges",[])
        if changes and "text" in changes[-1]:
            docs.setdefault(uri, {}).update({"text":changes[-1]["text"],"version":td.get("version",0)})
        # v1: don't infer on every keystroke; wait for save/hotkey. Still update buffer.
    elif method == "textDocument/didSave":
        td = p.get("textDocument",{}); uri = td.get("uri","")
        if uri not in docs: return
        if isinstance(p.get("text"), str): docs[uri]["text"] = p["text"]
        infer_and_publish(uri, "save")
    elif method == "textDocument/didClose":
        uri = p.get("textDocument",{}).get("uri","")
        docs.pop(uri, None)
        send_notification("textDocument/publishDiagnostics", {"uri":uri,"diagnostics":[]})
    elif method == "workspace/executeCommand":
        cmd = p.get("command",""); args = p.get("arguments",[]) or []
        if cmd == "redFactor.setDepth":
            try:
                if args: depth = max(0,min(2,int(args[0])))
                else: depth = 2 if depth == 1 else 1
                log("depth ->",depth)
            except Exception: pass
            # re-run on all open docs
            for uri in list(docs): infer_and_publish(uri, f"depth {depth}")
        if id_ is not None: send_response(id_, {"depth":depth})
    elif id_ is not None:
        # unhandled request -> empty to keep Helix happy
        send_response(id_, {})
    return None

def main():
    log(f"up url={LLM_URL} model={MODEL} depth={depth}")
    while True:
        try: msg = read_msg()
        except Exception as e: log("read err:",e); continue
        if msg is None: break
        try:
            if handle(msg) == "shutdown": continue
        except Exception as e:
            log("handle err:",e)
            if msg.get("id") is not None: send_error(msg["id"], str(e))

if __name__ == "__main__":
    main()
